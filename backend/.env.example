# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.
DATABASE_URL=postgresql+psycopg://vacaciones:vacaciones@localhost:5432/vacaciones
SECRET_KEY=cambia-esta-clave-en-produccion
FRONTEND_ORIGINS=http://localhost:5173

# ---- Sesión (cookie HttpOnly) ----
SESSION_COOKIE_SECURE=false        # true en producción (HTTPS)
SESSION_COOKIE_SAMESITE=lax
SESSION_HOURS=10

# ---- Usuario y contraseña ----
# Se conserva para el personal de planta sin cuenta Microsoft.
PASSWORD_LOGIN_ENABLED=true
# Roles que pueden entrar con contraseña (vacío = todos). Recomendado en producción: planta
PASSWORD_LOGIN_ROLES=

# ---- Microsoft Entra ID (ver docs/MICROSOFT_ENTRA.md) ----
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Secreto: solo en .env o en el administrador de secretos del servidor
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/api/auth/microsoft/callback
MICROSOFT_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
MICROSOFT_SCOPES=openid profile email User.Read
# Alta de empleados con datos y foto de Microsoft (permiso de aplicación User.Read.All)
MICROSOFT_GRAPH_ENABLED=false

# ---- Reglas de vacaciones ----
# true = los días se otorgan al cumplir cada año de servicio (LFT); false = desde el inicio del año
VACACIONES_AL_CUMPLIR_ANIO=true
# Meses para disfrutar los días de un periodo; después se pierden
MESES_VIGENCIA_PERIODO=18

APP_NOMBRE=SIP-O
APP_DESCRIPCION=Sistema Integral de Personal O-Tek
